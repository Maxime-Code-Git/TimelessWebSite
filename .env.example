# ============================================================
# TIMELESS — Environment Variables Example
# Copy to .env.local (dev) or .env.production (prod)
# NEVER commit the real .env files
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:5173
TRUST_PROXY=false

# --- Admin ---
# Generate with: node -e "require('crypto').randomBytes(16).toString('hex').then?.(console.log) || console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PATH=/admin-changeme-generate-a-real-random-path
# Generate hash with: node scripts/set-admin-password.sh
ADMIN_PASSWORD_HASH=

# --- Sessions ---
# Session secret for cookie signing
SESSION_SECRET="generate-a-secure-secret-here"

# Rate Limiting configuration
CONTACT_RATE_LIMIT_SECRET="another-secure-secret"
RATE_LIMIT_DB_PATH="./data/db/rate-limit.sqlite"
CONTACT_RATE_LIMIT_MAX="5"

# --- Media signing (download tokens) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEDIA_SIGNING_KEY=change-me-generate-32-random-bytes

# --- Database ---
DATABASE_PATH=./data/database/timeless.db

# --- Media storage ---
MEDIA_PATH=./data/media

# --- SMTP relay ---
# SMTP Relay Configuration (Brevo)
# Do NOT fill the password here. Put it in .env.local only!
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Timeless <timeless.studiolm@gmail.com>"
SMTP_TO="timeless.studiolm@gmail.com"

# --- Backup (production only) ---
# BACKUP_REMOTE=b2:your-bucket-name
# BACKUP_ENCRYPTION_KEY_FILE=/etc/timeless/backup.key

# --- Disk warning thresholds ---
DISK_WARN_70=true
DISK_WARN_85=true
DISK_WARN_95=true
