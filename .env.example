# --- Environment Configuration ---
# Duplicate this file to .env.local at the root of the repository for development.
# In production, variables should be injected by your orchestrator or service manager.

# --- Core Settings ---
PUBLIC_SITE_URL=http://localhost:5173

# TRUST_PROXY: set to false in local development.
# In production, this MUST be set to true and the app MUST be deployed behind
# a properly configured reverse proxy (Nginx, Caddy, etc.) that sets X-Forwarded-For.
TRUST_PROXY=false

# --- Authentication & Security ---
# To generate a random secret, run: openssl rand -hex 32
CONTACT_RATE_LIMIT_SECRET=
ADMIN_SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# --- Rate Limiting ---
RATE_LIMIT_DB_PATH=./data/db/rate-limit.sqlite
CONTACT_RATE_LIMIT_MAX=5

# --- Media storage ---
MEDIA_PATH=./data/media

# --- SMTP relay (Brevo) ---
# Do NOT fill secrets here. Put real values in .env.local only!
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Timeless <timeless.studiolm@gmail.com>"
SMTP_TO=timeless.studiolm@gmail.com

# --- Content ---
# Path to the JSON configuration file (Phase 3B)
# Do not commit the actual site-content.json to Git
SITE_CONTENT_PATH=./data/site-content.json

# Portfolio Config
PORTFOLIO_CONTENT_PATH=./data/portfolio.json
PORTFOLIO_MEDIA_PATH=./data/media/portfolio
