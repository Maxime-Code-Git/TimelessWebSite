{
  "name": "timeless",
  "version": "1.0.0",
  "private": true,
  "description": "Timeless Photo & Video — Studio de photographie et vidéo de mariage",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web & npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "convert-fonts": "bash scripts/convert-fonts.sh",
    "setup-admin": "bash scripts/set-admin-password.sh"
  }
}